# Entorno para docker-compose.prod.yml (NAS o servidor).
# Copia este archivo como `.env` junto al compose y rellena los valores.
# NO lo subas al repositorio.

# --- Base de datos ---
# Solo letras y números: se inserta dentro de DATABASE_URL sin escapar.
POSTGRES_PASSWORD=

# --- Imagen ---
# `latest` sigue a main. Para un despliegue reproducible fija una versión:
#   ghcr.io/lorenzocostabile/app_custom_feed:0.2.0
# o un commit: ...:sha-1a2b3c4
ATENCION_IMAGE=ghcr.io/lorenzocostabile/app_custom_feed:latest

# Puerto publicado en el host. Apunta ahí el proxy inverso del NAS.
APP_PORT=3000

# Zona horaria del planificador (ingesta, recomendaciones y edición).
TZ=Europe/Madrid

# --- Aplicación ---
EDITION_SIZE=10
CANDIDATE_WINDOW_DAYS=14
REPEAT_COOLDOWN_DAYS=7
INGEST_USER_AGENT=Atencion/0.2 (personal feed reader)

# Administrador inicial: solo se crea si el usuario no existe todavía.
# Bórralas después del primer arranque si no quieres dejarlas en el archivo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# true solo si la app se sirve por HTTPS (proxy inverso con TLS).
# En http://ip:3000 déjalo en false o el login no funcionará.
SESSION_COOKIE_SECURE=true

# --- YouTube ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
# Debe coincidir EXACTAMENTE con el registrado en Google Cloud, usando el
# dominio del NAS. Si cambia, hay que volver a autorizar la cuenta.
YOUTUBE_REDIRECT_URI=https://atencion.example.com/api/youtube/callback
# 32 bytes en base64: openssl rand -base64 32
# Conserva la misma clave si quieres seguir descifrando tokens y cookies ya
# guardados; si la cambias, habrá que reconectar YouTube.
TOKEN_ENCRYPTION_KEY=
