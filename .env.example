DATABASE_URL=postgres://atencion:atencion@localhost:5432/atencion
INGEST_USER_AGENT=Atencion/0.2 (personal feed reader)
EDITION_SIZE=10
CANDIDATE_WINDOW_DAYS=14
REPEAT_COOLDOWN_DAYS=7

# Administrador inicial (solo se usa si no existe todavía).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia-esta-contraseña
ADMIN_NAME=Administrador

# true cuando sirvas la app por HTTPS (proxy inverso con TLS); false en HTTP local.
SESSION_COOKIE_SECURE=false

# YouTube (Fase 1). Crea un cliente OAuth de tipo Web en Google Cloud.
# El redirect URI debe coincidir exactamente con el registrado en Google.
# GOOGLE_API_KEY es OPCIONAL: si no la defines, se usan los tokens OAuth del
# usuario para leer las duraciones de los vídeos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
# Clave de 32 bytes en base64 para cifrar los tokens OAuth. Genérala con:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
